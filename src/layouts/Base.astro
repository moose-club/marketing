---
// Poppins, self-hosted at 400–800 (RULES 12). Each file covers its subsets by
// unicode-range, so a Latin page downloads only the Latin files.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins800 from '@fontsource/poppins/files/poppins-latin-800-normal.woff2?url';
import '../styles/globals.css';
import { SITE } from '../data/copy';
import { SITE_URL, graph, siteNodes } from '../data/schema';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  preloadImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page, joined to the site-wide graph. */
  jsonLd?: Record<string, unknown>[];
  /** Follow the system's dark mode (RULES 8). Off only for a page that isn't
      redrawn on the Member Card yet: its shipped CSS doesn't flip. */
  followSystemDark?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonical,
  ogImage = '/og.png',
  preloadImage,
  noindex = false,
  jsonLd = [],
  followSystemDark = true,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? SITE_URL;
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const structuredData = graph([...siteNodes, ...jsonLd]);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta name="color-scheme" content={followSystemDark ? 'light dark' : 'light'} />
    {followSystemDark && (
      <script is:inline>
        // Dark mode follows the system (RULES 8): the generated tokens' dark
        // values live on `.dark`. Inline in <head> so it lands before first
        // paint, and it follows a change while the page is open.
        (() => {
          const dark = matchMedia('(prefers-color-scheme: dark)');
          const apply = () => document.documentElement.classList.toggle('dark', dark.matches);
          apply();
          dark.addEventListener('change', apply);
        })();
      </script>
    )}

    <link rel="preload" as="font" type="font/woff2" href={poppins400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={poppins800} crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="40x40" href="/brand/icon/Icon-40.png" />
    <link rel="icon" type="image/png" sizes="76x76" href="/brand/icon/Icon-76.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/brand/icon/Icon-60@3x.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/icon/Icon-60@3x.png" />
    {/* Literal by necessity: a meta tag can't read a CSS var. Keep in step
        with --m-moose-navy. */}
    <meta name="theme-color" content="#1A2B5F" />

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Moose" />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Gate for the scroll-reveal styles: without JS the page renders
         fully visible. Inline so it lands before first paint. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      // Scroll reveal — adds .is-revealed once an element enters the viewport.
      // Styles live in globals.css under the html.js gate.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const revealIO = new IntersectionObserver(
        (entries, io) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-revealed');
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );
      revealEls.forEach((el) => revealIO.observe(el));

      // Count-up — elements with data-countup tick from 0 to their rendered
      // value on first view. Non-numeric prefix/suffix ("$", "k", "+") are
      // preserved, so copy stays the single source of truth.
      const countEls = document.querySelectorAll<HTMLElement>('[data-countup]');
      const countIO = new IntersectionObserver(
        (entries, io) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.unobserve(entry.target);
            runCount(entry.target as HTMLElement);
          }
        },
        { threshold: 0.6 }
      );

      function runCount(el: HTMLElement) {
        const text = (el.textContent ?? '').trim();
        const match = text.match(/^([^\d]*)(\d+(?:\.\d+)?)(.*)$/);
        if (!match || reduceMotion) return;
        const [, pre, numStr, post] = match;
        const target = parseFloat(numStr);
        const decimals = (numStr.split('.')[1] ?? '').length;
        const duration = 1100;
        const start = performance.now();
        const tick = (now: number) => {
          const k = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = pre + (target * eased).toFixed(decimals) + post;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
      countEls.forEach((el) => countIO.observe(el));
    </script>
  </body>
</html>

---
import { VALUE } from '../../data/copy';

// Station · For studios — lettering on your lane; the three figures on your
// partner's, the figure travelling with its row (no boxes). The two masses
// rest on one tread.
---

<section class="station lanes value" id="value" aria-labelledby="valueHeading">
  <div>
    <h2 id="valueHeading" class="lettering lettering--station">{VALUE.head}</h2>
    <p class="lead">{VALUE.prizeNote}</p>
  </div>

  <ul class="lane--partner lane--indent figures">
    {VALUE.benefits.map((b) => (
      <li class="figure">
        <p class="figure__row">
          <span class="figure__stat">{b.stat}</span>
          <span class="detail">{b.unit}</span>
        </p>
        <p class="plate-label figure__title">{b.title}</p>
        <p class="detail figure__cap">{b.cap}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .figures { display: grid; gap: var(--m-spacing-lg); }
  .figure__row {
    display: flex;
    align-items: baseline;
    gap: 6px; /* no token yet: proposed */
  }
  .figure__stat {
    font-size: var(--ll-stat-size);
    font-weight: var(--m-type-figure-weight);
    line-height: var(--m-type-figure-leading);
    letter-spacing: var(--m-type-figure-tracking);
    font-variant-numeric: var(--m-type-figure-numeric);
    color: var(--m-ink);
  }
  .figure__title { margin-top: var(--m-spacing-sm); }
  .figure__cap { margin-top: 6px; max-width: 34ch; } /* no token yet: proposed (gap 6) */

  @media (min-width: 1048px) {
    .value > * { grid-row: 1; }
    .figures {
      align-self: end;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--m-spacing-xl);
    }
  }
</style>

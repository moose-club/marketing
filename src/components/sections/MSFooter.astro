---
import { FOOTER } from '../../data/copy';
import Icon from '../primitives/Icon.astro';

// The footer (Member Card; Figma `159:984` / `159:1018`). It continues the
// close's navy band with no seam: the token set's own `.dark`, so ink, rules and
// the wordmark flip from one class (RULES 8). Brand on the left, the printed
// columns on the right, then a printed rule and the legal row.
//
// `home={false}` on any page but `/`, so the section anchors lead back home.
interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const to = (href: string) => (!home && href.startsWith('#') && href !== '#top' ? `/${href}` : href);
const year = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="page footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="#top" class="footer__wordmark" aria-label="Moose, back to top"><span aria-hidden="true"></span></a>
        <p class="footer__tagline">{FOOTER.tagline}</p>
        <a href={FOOTER.instagram.href} class="footer__ig" target="_blank" rel="noopener" aria-label={FOOTER.instagram.label}>
          <Icon name="instagram" />
        </a>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        {FOOTER.cols.map((c) => (
          <div class="footer__col">
            <h2 class="footer__head">{c.title}</h2>
            <ul>
              {c.items.map((it) => {
                const external = 'external' in it && it.external;
                return (
                  <li>
                    <a href={to(it.h)} class="footer__link" {...(external ? { target: '_blank', rel: 'noopener' } : {})}>{it.l}</a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="footer__legal">
      <div class="footer__group">
        <span class="footer__copy">© {year} Moose Club. Made in Australia.</span>
        {FOOTER.legal.map((l) => <a href={l.h}>{l.l}</a>)}
      </div>
      <div class="footer__group">
        <a href={FOOTER.register.h} target="_blank" rel="noopener">{FOOTER.register.l}</a>
        <a href="#top">{FOOTER.backToTop}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--m-floor);
    color: var(--m-ink);
  }
  .footer__inner {
    display: grid;
    gap: var(--m-spacing-xl);
    padding-top: var(--m-spacing-xxl);
    padding-bottom: var(--m-spacing-xl);
  }

  .footer__top {
    display: grid;
    gap: var(--m-spacing-xl);
  }

  .footer__brand {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: var(--m-spacing-sm);
  }
  /* One ink (RULES 7): the wordmark is a mask filled with `ink`. */
  .footer__wordmark span {
    display: block;
    width: 120px;
    aspect-ratio: 120 / 23;
    background: var(--m-ink);
    -webkit-mask: url('/brand/logo/moose-wordmark-navy.svg') center / contain no-repeat;
    mask: url('/brand/logo/moose-wordmark-navy.svg') center / contain no-repeat;
  }
  .footer__tagline {
    margin-top: var(--m-spacing-xs);
    font-size: var(--m-type-body-size);
    line-height: var(--m-type-body-leading);
    color: var(--m-ink-support);
  }
  .footer__ig {
    display: inline-flex;
    margin-top: var(--m-spacing-xs);
    min-width: 44px;
    min-height: 44px; /* RULES 17 */
    align-items: center;
    color: var(--m-ink);
  }

  .footer__cols {
    display: grid;
    gap: var(--m-spacing-xl);
  }
  .footer__head {
    margin: 0 0 var(--m-spacing-sm);
    font-size: var(--m-type-printed-label-size);
    font-weight: var(--m-type-printed-label-weight);
    line-height: var(--m-type-printed-label-leading);
    letter-spacing: var(--m-type-printed-label-tracking);
    text-transform: var(--m-type-printed-label-transform);
    color: var(--m-ink-support);
  }
  .footer__col ul { display: grid; gap: var(--m-spacing-xs); }
  .footer__link {
    display: inline-block;
    padding-block: 6px; /* no token yet: proposed (44px hit row with body leading) */
    font-size: var(--m-type-body-size);
    line-height: var(--m-type-body-leading);
    color: var(--m-ink);
    overflow-wrap: anywhere;
    text-underline-offset: 4px;
  }
  .footer__link:hover,
  .footer__link:focus-visible { text-decoration: underline; }

  .footer__legal {
    display: grid;
    gap: var(--m-spacing-sm);
    padding-top: var(--m-spacing-lg);
    border-top: 1px solid var(--m-ink-rule);
    font-size: var(--m-type-detail-size);
    line-height: var(--m-type-detail-leading);
    color: var(--m-ink-support);
  }
  .footer__group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m-spacing-xs) var(--m-spacing-lg);
  }
  .footer__copy { flex-basis: 100%; }
  .footer__legal a { color: inherit; text-underline-offset: 3px; }
  .footer__legal a:hover,
  .footer__legal a:focus-visible { color: var(--m-ink); text-decoration: underline; }

  /* Four columns: two by two until there's room for them in one row. */
  @media (min-width: 760px) {
    .footer__cols {
      grid-template-columns: repeat(2, max-content);
      justify-content: start;
      gap: var(--m-spacing-xl) 72px; /* no token yet: proposed (footer column gap) */
    }
    .footer__link { overflow-wrap: normal; white-space: nowrap; }
  }
  @media (min-width: 1280px) {
    .footer__cols {
      grid-template-columns: none;
      grid-auto-flow: column;
      column-gap: 48px; /* no token yet: proposed (footer column gap, four columns) */
    }
  }

  @media (min-width: 1048px) {
    .footer__inner {
      gap: 56px; /* no token yet: proposed */
      padding-top: 64px; /* no token yet: proposed */
      padding-bottom: 40px; /* no token yet: proposed */
    }
    .footer__top {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }
    .footer__legal {
      display: flex;
      justify-content: space-between;
    }
    .footer__copy { flex-basis: auto; }
  }
</style>

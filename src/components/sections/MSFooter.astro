---
import { FOOTER } from '../../data/copy';
import Icon from '../primitives/Icon.astro';

// The navy floor continues from the close, no seam and no hairline. Brand on
// your lane, link columns on your partner's.
const year = new Date().getFullYear();
---

<footer class="footer dark">
  <div class="lanes footer__top">
    <div class="footer__brand">
      <img src="/brand/logo/moose-wordmark-white.svg" alt="Moose" class="footer__logo" width="120" height="23" />
      <p class="body-copy">{FOOTER.tagline}</p>
      <a href={FOOTER.instagram.href} class="footer__ig" target="_blank" rel="noopener" aria-label={FOOTER.instagram.label}>
        <Icon name="instagram" />
      </a>
    </div>

    <div class="lane--partner footer__cols">
      {FOOTER.cols.map((c) => (
        <div class="footer__col">
          <h2 class="plate-label">{c.title}</h2>
          {c.items.map((it) => {
            const external = 'external' in it && it.external;
            return (
              <a href={it.h} class="body-copy footer__link" {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
                {it.l}
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>

  <div class="footer__legal detail">
    <div class="footer__row">
      <span>© {year} Moose Club. Made in Australia.</span>
      {FOOTER.legal.map((l) => <a href={l.h}>{l.l}</a>)}
    </div>
    <div class="footer__row">
      <a href={FOOTER.register.h} target="_blank" rel="noopener">{FOOTER.register.l}</a>
      <a href="#top">{FOOTER.backToTop}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--m-bg);
    color: var(--m-ink);
    padding-top: calc(var(--rhythm) + var(--m-spacing-md));
    padding-bottom: var(--m-spacing-xl);
  }
  .footer__top { row-gap: var(--m-spacing-xxl); }

  .footer__brand { display: grid; justify-items: start; align-content: start; gap: var(--m-spacing-md); }
  .footer__logo { display: block; width: 120px; height: auto; }
  .footer__ig { color: var(--m-ink); display: inline-flex; }
  .footer__ig:hover { color: var(--m-ink-support); }

  .footer__cols { display: grid; gap: var(--m-spacing-lg); }
  .footer__col { display: grid; align-content: start; gap: 10px; } /* no token yet: proposed */
  .footer__link { transition: color var(--dur-fast) var(--ease-out); overflow-wrap: anywhere; }
  .footer__link:hover { color: var(--m-ink); }

  .footer__legal {
    max-width: var(--floor-max);
    margin: var(--m-spacing-xxl) auto 0;
    padding-inline: var(--floor-pad-start) var(--floor-pad-end);
    display: grid;
    gap: var(--m-spacing-sm);
  }
  .footer__row { display: flex; flex-wrap: wrap; gap: var(--m-spacing-sm) var(--m-spacing-lg); }
  .footer__legal a { transition: color var(--dur-fast) var(--ease-out); }
  .footer__legal a:hover { color: var(--m-ink); }

  @media (min-width: 760px) {
    .footer__cols {
      display: flex;
      flex-wrap: wrap;
      gap: var(--m-spacing-lg) var(--m-spacing-xl);
    }
    .footer__col { min-width: 170px; } /* no token yet: proposed */
    .footer__link { overflow-wrap: normal; white-space: nowrap; }
  }
  @media (min-width: 1048px) {
    .footer__top > * { grid-row: 1; }
    .footer__legal {
      margin-top: 96px; /* no token yet: proposed (Figma legal row at 271) */
      padding-inline: calc(var(--floor-pad-start) - var(--line-inset)) calc(var(--floor-pad-end) - var(--line-inset));
      display: flex;
      justify-content: space-between;
    }
  }
</style>

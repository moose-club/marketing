---
import { NAV } from '../../data/copy';
import Icon from '../primitives/Icon.astro';

// 72px nav, transparent on the floor; once scrolled it takes a Surface/bg fill
// and a Label/inkHairline bottom edge (no blur, no shadow). The wordmark's
// first stem sits on lane 0, where the live line starts. Each floor has its
// own link set; "Studio login" is the outline station action plate, so the
// first viewport keeps one filled plate.
---

<header class="nav" data-scrolled="false" id="top">
  <div class="nav__inner">
    <a href="#top" class="nav__brand" aria-label="Moose home">
      <img src="/brand/logo/moose-wordmark-navy.svg" alt="Moose" class="nav__logo" width="120" height="23" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {NAV.studioLinks.map((l) => <a href={l.href} class="nav__link" data-floor-only="studio">{l.label}</a>)}
      {NAV.memberLinks.map((l) => <a href={l.href} class="nav__link" data-floor-only="member">{l.label}</a>)}
      <a class="plate plate--outline plate--station nav__portal" href={NAV.portal.href} target="_blank" rel="noopener">
        {NAV.portal.label}
      </a>
    </nav>

    <button
      class="nav__toggle"
      id="navToggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="navMobile"
    >
      <Icon name="menu" />
    </button>
  </div>

  <nav class="nav__mobile" id="navMobile" aria-label="Mobile" data-open="false">
    {NAV.studioLinks.map((l) => <a href={l.href} class="nav__mobile-link" data-floor-only="studio">{l.label}</a>)}
    {NAV.memberLinks.map((l) => <a href={l.href} class="nav__mobile-link" data-floor-only="member">{l.label}</a>)}
    <a href={NAV.portal.href} target="_blank" rel="noopener" class="plate plate--outline plate--station nav__mobile-portal">
      {NAV.portal.label}
    </a>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  if (nav) {
    const handler = () => nav.setAttribute('data-scrolled', String(window.scrollY > 16));
    handler();
    window.addEventListener('scroll', handler, { passive: true });
  }

  // Mobile menu toggle + auto-close on link tap.
  const toggle = document.getElementById('navToggle');
  const mobile = document.getElementById('navMobile');
  if (toggle && mobile) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      mobile.dataset.open = String(!open);
    });
    mobile.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        mobile.dataset.open = 'false';
      }
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: background var(--dur-base) var(--ease-out), border-color var(--dur-base);
  }
  .nav[data-scrolled='true'],
  .nav:has(.nav__mobile[data-open='true']) {
    background: var(--m-bg);
    border-bottom-color: var(--m-ink-hairline);
  }

  /* The wordmark's first stem lands on lane 0: the floor's content edge, less
     the line inset. */
  .nav__inner {
    max-width: var(--floor-max);
    margin-inline: auto;
    height: var(--nav-h);
    padding-inline: calc(var(--floor-pad-start) - var(--line-inset)) var(--floor-pad-end);
    display: flex;
    align-items: center;
    gap: var(--m-spacing-xl);
  }
  .nav__brand { display: inline-flex; flex-shrink: 0; }
  .nav__logo { display: block; width: 120px; height: auto; }

  .nav__links {
    display: none;
    align-items: center;
    gap: var(--m-spacing-xl);
    margin-left: auto;
  }
  .nav__link {
    font-size: var(--ll-body-size);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--ll-tracking);
    color: var(--m-ink-support);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__link:hover { color: var(--m-ink); }

  /* Each floor shows its own links. */
  [data-floor-only='member'] { display: none; }
  :global(html[data-audience='member']) [data-floor-only='studio'] { display: none; }
  :global(html[data-audience='member']) [data-floor-only='member'] { display: revert; }

  .nav__toggle {
    margin-left: auto;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--m-ink);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    padding: var(--m-spacing-sm) var(--floor-pad-end) var(--m-spacing-lg) var(--floor-pad-start);
  }
  .nav__mobile[data-open='true'] { display: flex; }
  .nav__mobile-link {
    padding: 14px 0;
    font-size: var(--m-type-plate-label-size);
    font-weight: var(--m-type-plate-label-weight);
    color: var(--m-ink);
  }
  .nav__mobile-portal { align-self: flex-start; margin-top: var(--m-spacing-sm); }

  @media (min-width: 1048px) {
    .nav__toggle { display: none; }
    .nav__mobile { display: none !important; }
    .nav__links { display: inline-flex; }
  }
</style>

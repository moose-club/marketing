---
import { HERO } from '../../data/copy';
import AudienceSwitch from '../primitives/AudienceSwitch.astro';
import HeroPhoto from '../primitives/HeroPhoto.astro';
import Icon from '../primitives/Icon.astro';
import Plate from '../primitives/Plate.astro';

// Studio floor hero — a split floor: the work side on your lane, the
// photograph from lane 2 to the edge. One filled plate.
---

<section class="hero" aria-labelledby="heroHeading">
  <HeroPhoto src={HERO.photo.src} alt={HERO.photo.alt} />

  <div class="lanes">
    <div class="hero__work">
      <AudienceSwitch current="studio" />

      <h1 id="heroHeading" class="lettering hero__head">{HERO.head}</h1>

      {HERO.subLines.map((line) => <p class="lead">{line}</p>)}

      <ul class="hero__points">
        {HERO.points.map((p) => (
          <li class="plate-label hero__point">
            <span class="tick"><Icon name="check" size={16} /></span>
            {p}
          </li>
        ))}
      </ul>

      <Plate href={HERO.cta.href} external class="hero__cta">{HERO.cta.label}</Plate>
    </div>
  </div>
</section>

<style>
  .hero__head { margin-top: var(--m-spacing-xl); }

  .hero__points {
    margin-top: var(--m-spacing-xl);
    display: grid;
    gap: 12px; /* no token yet: proposed (Figma point rhythm) */
  }
  .hero__point {
    display: flex;
    align-items: center;
    gap: 12px; /* no token yet: proposed */
  }
  /* Assurance tick: 24px solid ink box, 4px corner, surface check. Never
     status green, never pink. */
  .tick {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 4px; /* no token yet: proposed (Web/Tick) */
    background: var(--m-ink);
    color: var(--m-surface);
  }

  .hero__cta { margin-top: var(--m-spacing-xl); }
</style>

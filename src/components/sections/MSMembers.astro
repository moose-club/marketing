---
import { MEMBERS } from '../../data/copy';

// The member floor's three stations, each with its lettering on your lane and
// its matter on the partner lane: the steps, the commercials, and the app.

// The capture is the Browse day floor, rendered frameless straight out of the
// iOS app (mooseTests/Ui/BrowseFloorRenderTests.swift). It is deliberately
// taller than one phone screen — 402 x 1393 logical points against an 874pt
// window — because the height above the window *is* the scrub's travel. A
// one-screen capture has none, and the section falls back to a static frame.
const APP = {
  src: '/photos/member-app-browse.webp',
  width: 900,
  height: 3119,
  alt:
    "The Moose member app's Browse floor: one day of classes at the partner " +
    'studios near you, each with its time, studio, instructor and credit ' +
    'cost, and a pink mark beside the ones already booked.',
};
---

<section class="station lanes member-how" id="member-how" aria-labelledby="memberHowHeading" data-line-cross>
  <div>
    <h2 id="memberHowHeading" class="lettering lettering--station">{MEMBERS.how.head}</h2>
    <p class="lead">{MEMBERS.how.lede}</p>
  </div>
  <ol class="lane--partner lane--indent member-steps">
    {MEMBERS.how.steps.map((s) => (
      <li class="member-step">
        <span class="ordinal">{s.n}</span>
        <p class="body-copy">{s.body}</p>
      </li>
    ))}
  </ol>
</section>

<section class="station lanes member-get" id="member-get" aria-labelledby="memberGetHeading">
  <div>
    <h2 id="memberGetHeading" class="lettering lettering--station">{MEMBERS.commercials.head}</h2>
    <p class="lead">{MEMBERS.commercials.lede}</p>
  </div>
  <dl class="lane--partner lane--indent member-rows">
    {MEMBERS.commercials.rows.map((r) => (
      <div>
        <dt class="plate-label">{r.k}</dt>
        <dd class="body-copy">{r.body}</dd>
      </div>
    ))}
  </dl>
</section>

<section class="station lanes member-app" id="member-app" aria-labelledby="memberAppHeading">
  <div>
    <h2 id="memberAppHeading" class="lettering lettering--station">{MEMBERS.app.head}</h2>
    <p class="lead">{MEMBERS.app.lede}</p>
  </div>
  <div class="lane--partner lane--indent">
    <div class="app-lane">
      <img
        class="app-shot"
        src={APP.src}
        width={APP.width}
        height={APP.height}
        alt={APP.alt}
        loading="lazy"
        decoding="async"
        fetchpriority="low"
      />
    </div>
  </div>
</section>

<style>
  .member-steps { display: grid; gap: var(--m-spacing-xl); }
  .member-step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: var(--m-spacing-lg);
    align-items: start;
  }
  .member-step .body-copy { max-width: 504px; }

  .member-rows { display: grid; gap: var(--m-spacing-xl); }
  .member-rows dd { margin: var(--m-spacing-sm) 0 0; max-width: 572px; }

  @media (min-width: 1048px) {
    .member-how > *,
    .member-get > *,
    .member-app > * { grid-row: 1; }
  }

  /* ───── The app lane ─────────────────────────────────────────────────
     A window the shape of one phone screen, with the capture running taller
     than it behind a hard square crop. No bezel, no notch, no radius, no
     shadow — the app on the floor, not a stock device mock. */
  .app-lane {
    /* The window's shape. Independent of the capture's total height. */
    --window-w: 402;
    --window-h: 874;
    /* `100%` is the column (full container on mobile, `--lane-w` on desktop). */
    inline-size: min(100%, var(--lane-w));
    aspect-ratio: var(--window-w) / var(--window-h);
    /* Makes 100cqh below resolve to this box's used height. */
    container-type: size;
    overflow: hidden;
    border-radius: 0;
    /* The app's own ground, so a sub-pixel gap on the last frame is invisible. */
    background: var(--m-surface);
  }

  .app-shot {
    /* 0–1 throttle on the scrub, for tuning feel without re-exporting. */
    --app-scrub: 1;
    /* `translateY` percentages resolve against the element's own height, so
       `100%` is the image and `100cqh` is the window: the difference is
       exactly "top-flush to bottom-flush". Nothing here names the asset, so
       swapping the capture touches only the <img> attributes. A capture only
       one screen tall computes 0 and simply sits still. */
    --app-travel: calc((100cqh - 100%) * var(--app-scrub));

    display: block;
    inline-size: 100%;
    /* Not `object-fit: cover` — cover would crop away the travel. */
    block-size: auto;
  }

  /* ───── The scrub ────────────────────────────────────────────────────
     The timeline goes on the lane, the animation on the image. Not a
     preference: a view timeline measures its subject against the subject's
     nearest ancestor scroll container, and the lane is `overflow: hidden`,
     so an anonymous `view()` on the image would measure it against a box that
     never scrolls and freeze at a constant.

     Nested inside `no-preference` rather than switched off under `reduce`
     (which is what MSTicker does for its marquee, correctly). A progress
     timeline is not a duration: globals.css's `animation-duration: 0.01ms
     !important` would not stop this one, it would snap the image to its end
     frame — the bottom of the capture — and hold it. Under `reduce` the
     declarations must not exist at all. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .app-lane {
        view-timeline: --member-app block;
        /* MSNav is fixed and 72px tall; shrinking the scrollport by it lands
           "exit 0%" just under the nav rather than behind it. */
        view-timeline-inset: 72px 0;
      }

      .app-shot {
        /* Shorthand FIRST — `animation` resets `animation-timeline` to `auto`,
           so declaring the timeline above it silently kills the scrub. */
        animation: app-scrub linear both;
        animation-timeline: --member-app;
        /* Length is `V - 0.7L`: starts as the lane comes into view, and the
           final frame lands with the whole lane still on screen. `contain`
           would collapse to near-zero wherever the lane height approaches the
           viewport height, and snap. */
        animation-range: entry 70% exit 0%;
        will-change: transform;
      }
    }
  }

  @keyframes app-scrub {
    from { transform: translateY(0); }
    to   { transform: translateY(var(--app-travel)); }
  }

  .app-lane {
    /* The lane's width: the drawn 340, and short enough on a short viewport
       that the whole window is under the fold, so the scrub has somewhere to
       happen. `svh`, never `dvh` — `dvh` would resize the lane mid-scroll. */
    --lane-w: min(340px, calc(76svh * 402 / 874));
  }
</style>

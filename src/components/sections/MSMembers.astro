---
import { MEMBERS } from '../../data/copy';

// The capture is the Browse day floor, rendered frameless straight out of the
// iOS app (mooseTests/Ui/BrowseFloorRenderTests.swift). It is deliberately
// taller than one phone screen — 402 x 1393 logical points against an 874pt
// window — because the height above the window *is* the scrub's travel. A
// one-screen capture has none, and the section falls back to a static frame.
const APP = {
  src: '/photos/member-app-browse.webp',
  width: 900,
  height: 3119,
  alt:
    "The Moose member app's Browse floor: one day of classes at the partner " +
    'studios near you, each with its time, studio, instructor and credit ' +
    'cost, and a pink mark beside the ones already booked.',
};
---

<section class="section section--cream members" id="members" aria-labelledby="memberHeading">
  <div class="container">
    <div class="members__grid">
      <span class="eyebrow eyebrow--ink members__eyebrow">{MEMBERS.eyebrow}</span>

      <div class="members__copy">
        <h2 id="memberHeading" class="members__head" set:html={MEMBERS.headHtml}></h2>

        <p class="lede members__lede">
          {MEMBERS.ledeLines.map((line) => <span class="members__lede-line">{line}</span>)}
        </p>

        <dl class="members__commercials">
          {MEMBERS.commercials.map((c) => (
            <div class="mc">
              <dt class="mc__k">{c.k}</dt>
              <dd class="mc__body">{c.body}</dd>
            </div>
          ))}
        </dl>

        <p class="members__note" set:html={MEMBERS.noteHtml}></p>
      </div>

      <div class="members__app">
        <div class="app-lane">
          <img
            class="app-shot"
            src={APP.src}
            width={APP.width}
            height={APP.height}
            alt={APP.alt}
            loading="lazy"
            decoding="async"
            fetchpriority="low"
          />
        </div>
        <p class="members__callout">
          {MEMBERS.calloutLines.map((line) => <span class="members__callout-line">{line}</span>)}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ───── Band ─────────────────────────────────────────────────────────
     Copy left, a pink hairline spine, the app right. The spine is the only
     decorative pink on the page — everything else in this section is ink, so
     the band keeps to one accent plus the headline's one pink word. */
  .members__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--s-6);

    /* The lane's width, resolved here rather than inside `.app-lane`, because
       the desktop grid gives the lane its own track and a track sized `auto`
       against a child sized `100%` is circular — it settled ~30px narrow. The
       second term is the load-bearing one: it keeps the whole lane under the
       fold on short viewports, so the scrub has somewhere to happen.
       `svh`, never `dvh` — `dvh` would resize the lane mid-scroll as a mobile
       toolbar collapses, recomputing range and travel at once. */
    --lane-w: min(360px, calc(76svh * 402 / 874));
  }

  .members__head {
    font-size: clamp(24px, 3.4vw, 46px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--navy);
    margin: var(--s-4) 0 0;
  }
  .members__head em { color: var(--pink); }

  .members__lede { margin-top: var(--s-5); font-weight: 400; max-width: 46ch; }
  .members__lede-line { display: block; }
  .members__lede-line + .members__lede-line { margin-top: 0.8em; }

  /* Open term/definition rows, not cards: no surface, no border, no shadow. */
  .members__commercials {
    margin-top: var(--s-8);
    display: grid;
    gap: var(--s-6);
  }
  .mc__k {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* Ink, not pink: at 12px on cream, pink fails WCAG contrast. */
    color: var(--ink);
  }
  .mc__body {
    margin: var(--s-2) 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-dim);
    max-width: 46ch;
  }

  .members__note { margin-top: var(--s-8); font-size: 14px; color: var(--ink-dim); }
  .members__note a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .members__note a:hover { text-decoration-color: var(--ink); }

  /* ───── The app lane ─────────────────────────────────────────────────
     A window the shape of one phone screen, with the capture running taller
     than it behind a hard square crop. No bezel, no notch, no radius, no
     shadow — the app on the floor, not a stock device mock. */
  .members__app {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }

  .app-lane {
    /* The window's shape. Independent of the capture's total height. */
    --window-w: 402;
    --window-h: 874;
    /* `100%` is the column (full container on mobile, `--lane-w` on desktop). */
    inline-size: min(100%, var(--lane-w));
    aspect-ratio: var(--window-w) / var(--window-h);
    /* Makes 100cqh below resolve to this box's used height. */
    container-type: size;
    overflow: hidden;
    border-radius: 0;
    /* The app's own ground, so a sub-pixel gap on the last frame is invisible. */
    background: var(--card);
  }

  .app-shot {
    /* 0–1 throttle on the scrub, for tuning feel without re-exporting. */
    --app-scrub: 1;
    /* `translateY` percentages resolve against the element's own height, so
       `100%` is the image and `100cqh` is the window: the difference is
       exactly "top-flush to bottom-flush". Nothing here names the asset, so
       swapping the capture touches only the <img> attributes. A capture only
       one screen tall computes 0 and simply sits still. */
    --app-travel: calc((100cqh - 100%) * var(--app-scrub));

    display: block;
    inline-size: 100%;
    /* Not `object-fit: cover` — cover would crop away the travel. */
    block-size: auto;
  }

  /* ───── The scrub ────────────────────────────────────────────────────
     The timeline goes on the lane, the animation on the image. Not a
     preference: a view timeline measures its subject against the subject's
     nearest ancestor scroll container, and the lane is `overflow: hidden`,
     so an anonymous `view()` on the image would measure it against a box that
     never scrolls and freeze at a constant.

     Nested inside `no-preference` rather than switched off under `reduce`
     (which is what MSTicker does for its marquee, correctly). A progress
     timeline is not a duration: globals.css's `animation-duration: 0.01ms
     !important` would not stop this one, it would snap the image to its end
     frame — the bottom of the capture — and hold it. Under `reduce` the
     declarations must not exist at all. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .app-lane {
        view-timeline: --member-app block;
        /* MSNav is fixed and 72px tall; shrinking the scrollport by it lands
           "exit 0%" just under the nav rather than behind it. */
        view-timeline-inset: 72px 0;
      }

      .app-shot {
        /* Shorthand FIRST — `animation` resets `animation-timeline` to `auto`,
           so declaring the timeline above it silently kills the scrub. */
        animation: app-scrub linear both;
        animation-timeline: --member-app;
        /* Length is `V - 0.7L`: starts as the lane comes into view, and the
           final frame lands with the whole lane still on screen. `contain`
           would collapse to near-zero wherever the lane height approaches the
           viewport height, and snap. */
        animation-range: entry 70% exit 0%;
        will-change: transform;
      }
    }
  }

  @keyframes app-scrub {
    from { transform: translateY(0); }
    to   { transform: translateY(var(--app-travel)); }
  }

  /* Support text under the lane. No box, no wash, no icon — the band already
     spends its one mark on the spine. */
  .members__callout {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-dim);
    max-width: 34ch;
  }
  .members__callout-line { display: block; }
  .members__callout-line + .members__callout-line { margin-top: 0.5em; }

  /* ───── Mobile: the spine lies down ──────────────────────────────────
     A 1px vertical rule has nowhere to live in a stacked layout, so it becomes
     the horizontal divider between the copy and the app — full-bleed to the
     container edges, the way the vertical one bleeds to the section edges. */
  @media (max-width: 959.98px) {
    /* ::before is the grid's first box in tree order, so auto-placement puts
       it above the eyebrow. Every row is assigned explicitly to land it
       between the copy and the app, where the vertical rule sits on desktop. */
    .members__eyebrow { grid-row: 1; }
    .members__copy    { grid-row: 2; }
    .members__grid::before {
      content: '';
      grid-row: 3;
      block-size: 1px;
      background: var(--pink);
      margin-inline: calc(-1 * var(--container-px));
      margin-block: var(--s-6);
    }
    .members__app     { grid-row: 4; }
  }

  @media (min-width: 960px) {
    .members__grid {
      /* copy · spine · lane */
      grid-template-columns: minmax(0, 1fr) 1px var(--lane-w);
      grid-template-rows: auto 1fr;
      column-gap: clamp(28px, 4vw, 56px);
      row-gap: var(--s-6);
      align-items: start;
    }
    /* The eyebrow takes its own row so the lane's top edge lands level with
       the heading, structurally rather than by a guessed padding. */
    .members__eyebrow { grid-area: 1 / 1; }
    .members__copy    { grid-area: 2 / 1; }
    .members__app     { grid-area: 2 / 3; }

    /* A grid container's ::before is itself a grid item, so the spine is
       placed by the grid and cannot drift when the columns resize. The
       negative margin bleeds it into the section's own padding. */
    .members__grid::before {
      content: '';
      grid-area: 1 / 2 / -1 / 3;
      background: var(--pink);
      /* The grid's `align-items: start` applies to ::before too, and an empty
         box aligned to start is 0 tall — the rule silently vanished. */
      align-self: stretch;
      margin-block: calc(-1 * var(--section-pad));
      margin-inline: 0;
    }
  }
</style>

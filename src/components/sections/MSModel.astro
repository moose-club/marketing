---
import { MODEL } from '../../data/copy';

// Station · The Moose model — two lanes. Lettering, lede and 01–02 on your
// lane; 03–04 on your partner's. The live line crosses to the partner lane
// 48 above this station (`data-line-cross`).
const yours = MODEL.steps.slice(0, 2);
const partners = MODEL.steps.slice(2);
---

<section class="station lanes model" id="model" aria-labelledby="modelHeading" data-line-cross>
  <div class="model__intro">
    <h2 id="modelHeading" class="lettering lettering--station">{MODEL.head}</h2>
    <p class="lead">{MODEL.lede}</p>
    <h3 class="title model__title" id="how">{MODEL.stepsTitle}</h3>
  </div>

  <ol class="steps model__you">
    {yours.map((s) => (
      <li class="step">
        <span class="ordinal step__n">{s.n}</span>
        <div>
          <p class="plate-label">{s.title}</p>
          <p class="body-copy step__body" set:html={s.bodyHtml} />
        </div>
      </li>
    ))}
  </ol>

  <ol class="lane--partner lane--indent steps model__partner" start="3">
    {partners.map((s) => (
      <li class="step">
        <span class="ordinal step__n">{s.n}</span>
        <div>
          <p class="plate-label">{s.title}</p>
          <p class="body-copy step__body" set:html={s.bodyHtml} />
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .model__title { margin-top: var(--m-spacing-xxl); }

  .steps { display: grid; gap: var(--m-spacing-xl); }
  .step {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: start;
  }
  .step__n { color: var(--m-ink-support); }
  .step__body { margin-top: var(--m-spacing-sm); max-width: 516px; }

  @media (min-width: 1048px) {
    .step { grid-template-columns: 56px minmax(0, 1fr); }
    /* 03 sits level with 01: the partner has nothing to say until the
       crossover, so the floor above it is stated, not filled. */
    .model { row-gap: var(--m-spacing-xl); }
    .model__you, .model__partner { grid-row: 2; }
  }
</style>

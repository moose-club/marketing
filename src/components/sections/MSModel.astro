---
import { MODEL } from '../../data/copy';

// The Moose model (Member Card; Figma `135:570` / `135:662`). Type-led, with no
// card: the heroes carry the object. The headline with the lede beside it,
// then "How it works." over four printed columns, each under a printed rule
// (stacked on phone). Step bodies may carry a `<strong>` range (ink SemiBold).
---

<section class="model page" id="model" aria-labelledby="modelHeading">
  <div class="model__intro">
    <h2 id="modelHeading" class="page-lettering page-lettering--compact">{MODEL.head}</h2>
    <p class="body-text model__lede">{MODEL.lede}</p>
  </div>

  <h3 class="model__title" id="how">{MODEL.stepsTitle}</h3>
  <ol class="model__steps">
    {MODEL.steps.map((s) => (
      <li class="model__step">
        <span class="page-lettering model__n">{s.n}</span>
        <p class="model__step-title">{s.title}</p>
        <p class="body-text model__body" set:html={s.bodyHtml} />
      </li>
    ))}
  </ol>
</section>

<style>
  .model { padding-top: var(--rhythm); }

  .model__intro {
    display: grid;
    gap: var(--m-spacing-md);
  }

  .model__title {
    margin-top: 40px; /* no token yet: proposed (the 390 frame's intro → steps) */
    font-size: var(--m-type-plate-label-size);
    font-weight: var(--m-type-plate-label-weight);
    line-height: var(--m-type-plate-label-leading);
    color: var(--m-ink);
  }

  .model__steps {
    display: grid;
    gap: var(--m-spacing-lg);
    margin-top: var(--m-spacing-lg);
  }
  .model__step {
    padding-top: var(--m-spacing-lg);
    border-top: 1px solid var(--m-ink-rule);
  }
  /* The ordinal: display lettering at the compact role's phone size. */
  .model__n {
    display: block;
    font-size: 2.25rem; /* = --m-type-page-lettering-compact-size's floor */
    font-variant-numeric: tabular-nums;
  }
  .model__step-title {
    margin-top: 12px; /* no token yet: proposed (Figma step rhythm) */
    font-size: var(--m-type-plate-label-size);
    font-weight: var(--m-type-plate-label-weight);
    line-height: var(--m-type-plate-label-leading);
    color: var(--m-ink);
  }
  .model__body { margin-top: 12px; } /* no token yet: proposed */
  .model__body :global(strong) { font-weight: 600; color: var(--m-ink); }

  @media (min-width: 760px) {
    .model__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--m-spacing-xl);
      row-gap: var(--m-spacing-xl);
    }
  }

  @media (min-width: 1048px) {
    .model__intro {
      grid-template-columns: minmax(0, 560px) minmax(0, 520px);
      column-gap: 64px; /* no token yet: proposed (page gutter) */
      align-items: end;
    }
    .model__lede { max-width: none; }
    .model__title { margin-top: 64px; } /* no token yet: proposed */
    .model__steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>

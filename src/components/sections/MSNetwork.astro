---
import { NETWORK } from '../../data/copy';

// Station · Partner network — the studios already on Moose. Lettering, then
// the roster: every studio on the floor, its logo beside its name. Logos are
// single-ink masks filled with --m-ink, so every brand reads in navy; a fixed
// logo box keeps the names aligned (an empty box where no logo has landed yet,
// see NETWORK.partners). Regular floor: the lettering on your lane, the whole
// roster on your partner's (two columns from 1280), the line running in the gutter
// between them. Compact floor: one column under the lettering, capped at
// `compactVisible` with the rest revealing in place.
const partners = NETWORK.partners;
const extra = Math.max(0, partners.length - NETWORK.compactVisible);
---

<section class="station lanes network" id="network" aria-labelledby="networkHeading">
  <div class="network__intro">
    <h2 id="networkHeading" class="lettering lettering--station network__head">{NETWORK.head}</h2>
    <p class="lead">{NETWORK.lede}</p>
  </div>

  <ul class="roster lane--partner" id="roster" style={`--rows: ${Math.ceil(partners.length / 2)}`}>
    {partners.map((p, index) => {
      const logo = 'logo' in p ? p.logo : undefined;
      return (
        <li class="roster__mark" data-extra={index >= NETWORK.compactVisible ? '' : undefined}>
          <span class="roster__logo" aria-hidden="true" style={logo ? `--logo: url(${logo})` : undefined}></span>
          <a class="plate-label roster__name" href={p.href} target="_blank" rel="noopener">{p.name}</a>
        </li>
      );
    })}
  </ul>

  {extra > 0 && (
    <p class="roster__more">
      <span class="detail" data-more-count>{NETWORK.more(extra)}</span>
      <button
        type="button"
        class="plate plate--outline plate--station"
        aria-expanded="false"
        aria-controls="roster"
        data-roster-toggle
        data-show={NETWORK.showAll}
        data-hide={NETWORK.showLess}
      >
        {NETWORK.showAll}
      </button>
    </p>
  )}
</section>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-roster-toggle]');
  const station = toggle?.closest('.network');
  if (toggle && station) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? toggle.dataset.hide ?? '' : toggle.dataset.show ?? '';
      station.classList.toggle('is-open', open);
    });
  }
</script>

<style>

  /* Rhythm 16 compact, 24 regular. */
  .roster {
    display: grid;
    gap: var(--m-spacing-md);
  }
  .network > .roster { margin-top: var(--m-spacing-md); }

  .roster__mark {
    min-height: 40px; /* no token yet: proposed */
    display: flex;
    align-items: center;
    gap: var(--m-spacing-md);
  }
  .roster__logo {
    flex: none;
    width: 80px; /* no token yet: proposed */
    height: 40px; /* no token yet: proposed */
  }
  .roster__logo[style] {
    background-color: var(--m-ink);
    -webkit-mask: var(--logo) left center / contain no-repeat;
    mask: var(--logo) left center / contain no-repeat;
  }
  .roster__name {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .roster__name:hover { text-decoration-color: var(--m-ink-tape); }

  .roster__more {
    display: flex;
    align-items: center;
    gap: var(--m-spacing-md);
  }

  /* Compact: cap the roster; the rest reveal in place. */
  @media (max-width: 1047.98px) {
    .roster__mark[data-extra] { display: none; }
    .network.is-open .roster__mark[data-extra] { display: flex; }
    .network.is-open [data-more-count] { display: none; }
  }

  @media (min-width: 1048px) {
    /* Lettering left, roster right, level with each other; the line runs
       down the gutter between them. */
    .network > .roster {
      grid-row: 1;
      align-self: center;
      row-gap: var(--m-spacing-lg);
      margin-top: 0;
    }
    .roster__more { display: none; }
  }
  /* Two columns once the partner lane is wide enough that no name wraps. */
  @media (min-width: 1280px) {
    .network > .roster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: column;
      grid-template-rows: repeat(var(--rows), auto);
      column-gap: var(--m-spacing-lg);
    }
  }
</style>

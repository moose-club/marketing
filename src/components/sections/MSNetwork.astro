---
import { NETWORK } from '../../data/copy';

// Station · Partner network — the studios already on Moose. Lettering, then
// the roster: every studio on the floor, its name set as a mark (single ink,
// no chip) until its approved SVG lands. Regular floor: four columns, two on
// your lane and two on your partner's, the line running in the gutter between
// them. Compact floor: one column, capped at `compactVisible` with the rest
// revealing in place.
const partners = NETWORK.partners;
const half = Math.ceil(partners.length / 2);
const lanes = [partners.slice(0, half), partners.slice(half)];
const extra = Math.max(0, partners.length - NETWORK.compactVisible);
---

<section class="station lanes network" id="network" aria-labelledby="networkHeading">
  <div class="network__intro">
    <h2 id="networkHeading" class="lettering lettering--station network__head">{NETWORK.head}</h2>
    <p class="lead">{NETWORK.lede}</p>
  </div>

  {lanes.map((group, li) => (
    <ul
      class:list={['roster', li === 1 && 'lane--partner']}
      id={li === 0 ? 'roster' : 'roster-partner'}
      style={`--rows: ${Math.ceil(group.length / 2)}`}
    >
      {group.map((p, i) => {
        const index = li * half + i;
        return (
          <li class="roster__mark" data-extra={index >= NETWORK.compactVisible ? '' : undefined}>
            <a class="plate-label roster__name" href={p.href} target="_blank" rel="noopener">{p.name}</a>
          </li>
        );
      })}
    </ul>
  ))}

  {extra > 0 && (
    <p class="roster__more">
      <span class="detail" data-more-count>{NETWORK.more(extra)}</span>
      <button
        type="button"
        class="plate plate--outline plate--station"
        aria-expanded="false"
        aria-controls="roster roster-partner"
        data-roster-toggle
        data-show={NETWORK.showAll}
        data-hide={NETWORK.showLess}
      >
        {NETWORK.showAll}
      </button>
    </p>
  )}
</section>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-roster-toggle]');
  const station = toggle?.closest('.network');
  if (toggle && station) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? toggle.dataset.hide ?? '' : toggle.dataset.show ?? '';
      station.classList.toggle('is-open', open);
    });
  }
</script>

<style>

  /* Rhythm 12 compact, 14 regular (Figma bands of 28). */
  .roster {
    display: grid;
    gap: 12px; /* no token yet: proposed */
  }
  .network > .roster:first-of-type { margin-top: var(--m-spacing-md); }
  .network > .roster + .roster { margin-top: calc(12px - var(--m-spacing-xl)); }

  .roster__mark {
    min-height: 28px;
    display: flex;
    align-items: center;
  }
  .roster__name {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .roster__name:hover { text-decoration-color: var(--m-ink-tape); }

  .roster__more {
    display: flex;
    align-items: center;
    gap: var(--m-spacing-md);
  }

  /* Compact: cap the roster; the rest reveal in place. */
  @media (max-width: 1047.98px) {
    .roster__mark[data-extra] { display: none; }
    .network.is-open .roster__mark[data-extra] { display: flex; }
    .network.is-open [data-more-count] { display: none; }
  }

  @media (min-width: 1048px) {
    .network > .roster {
      grid-row: 2;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: column;
      grid-template-rows: repeat(var(--rows), auto);
      column-gap: var(--m-spacing-xl);
      row-gap: 14px; /* no token yet: proposed */
      margin-top: var(--m-spacing-xxl) !important;
    }
    .roster__more { display: none; }
  }
</style>

---
// The Moose loop, the only emblem (RULES 15): a mask filled with the current
// text colour, so it takes whichever ink it sits in. Decorative; the object
// it sits on carries the accessible name.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['loop', className]} aria-hidden="true"></span>

<style>
  .loop {
    display: block;
    aspect-ratio: 258 / 134;
    background: currentColor;
    -webkit-mask: url('/brand/logo/moose-loop.svg') center / contain no-repeat;
    mask: url('/brand/logo/moose-loop.svg') center / contain no-repeat;
  }
</style>

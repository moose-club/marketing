---
import { SWITCH } from '../../data/copy';

// The audience switch: two options above the hero headline. Chosen is a 2px
// ink edge with an ink label; the other a printed-rule edge with a support
// label. Never a fill: the view's one filled plate is its primary action
// (RULES 5). No chevron — a switch does not go forward. Behaviour lives in
// index.astro.
interface Props {
  current: 'studio' | 'member';
}

const { current } = Astro.props;
const options = [
  { id: 'studio', label: SWITCH.studio },
  { id: 'member', label: SWITCH.member },
] as const;
---

<div class="switch" role="group" aria-label={SWITCH.label}>
  {options.map((o) => (
    <button
      type="button"
      class="switch__plate"
      data-audience-set={o.id}
      aria-pressed={String(o.id === current)}
    >
      {o.label}
    </button>
  ))}
</div>

<style>
  .switch {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m-spacing-sm);
  }
  .switch__plate {
    min-height: 56px;
    padding-inline: var(--m-spacing-md);
    border: 2px solid var(--m-ink-rule);
    border-radius: var(--m-radius-component-plate);
    color: var(--m-ink-support);
    font-size: var(--m-type-plate-label-size);
    font-weight: var(--m-type-plate-label-weight);
    line-height: var(--m-type-plate-label-leading);
    white-space: nowrap;
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
    .switch__plate:active { transform: scale(0.98); }
  .switch__plate:hover { color: var(--m-ink); }
  .switch__plate[aria-pressed='true'] {
    border-color: var(--m-ink);
    color: var(--m-ink);
    cursor: default;
  }
  @media (min-width: 1048px) {
    .switch__plate { padding-inline: var(--m-spacing-lg); }
  }
</style>
